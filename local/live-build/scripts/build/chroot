set -e

# Including common functions
[ -e "${LIVE_BUILD}/scripts/build.sh" ] && . "${LIVE_BUILD}/scripts/build.sh" || . /usr/lib/live/build.sh

# LCOS 0.9.6: local copy of live-build 1:20250505+deb13u1 scripts/build/chroot.
# The only change is Installed_packages: the stock script writes
# chroot.packages.install and chroot.packages.live with a bare "dpkg-query -W",
# which also lists packages that are removed but not purged ("rc", as bootlogd
# was after plymouth replaced it). binary_manifest copies chroot.packages.live
# to live/filesystem.packages and <image>-<arch>.packages, so those manifests
# listed packages that are not installed. Only entries whose dpkg status is
# "installed" (ii, or hi when held) are written now, in the stock
# "${binary:Package}<TAB>${Version}" format.

# Chroot() word-splits its command, so the format must not contain spaces.
Installed_packages ()
{
	# shellcheck disable=SC2016 # dpkg-query expands the ${...} fields itself
	Chroot chroot 'dpkg-query -W -f=${db:Status-Status}\t${binary:Package}\t${Version}\n' > "${1}.status"
	awk -F '\t' '$1 == "installed" { print $2 "\t" $3 }' "${1}.status" > "${1}"
	rm -f "${1}.status"
	if [ ! -s "${1}" ]
	then
		Echo_error "%s is empty: dpkg-query in the chroot listed no installed packages" "${1}"
		exit 1
	fi
}

# Setting static variables
DESCRIPTION="Customize the Debian system"
USAGE="${PROGRAM} [--force]"

# Automatically populating config tree
Auto_build_config

# Processing arguments and configuration files
Init_config_data "${@}"

# Setting up cleanup function
Setup_clean_exit

# Restoring cached live OS chroot from cache
lb chroot_cache restore "${@}"

# Configuring chroot
lb chroot_prep install all mode-archives-chroot "${@}"

# Customizing chroot
lb chroot_linux-image "${@}"
lb chroot_firmware "${@}"
lb chroot_preseed "${@}"
lb chroot_includes_before_packages "${@}"

for _PASS in install live; do
	lb chroot_package-lists ${_PASS} "${@}"
	lb chroot_install-packages ${_PASS} "${@}"

	if [ "${_PASS}" = install ]; then
		Installed_packages chroot.packages.install
	fi
done

lb chroot_includes_after_packages "${@}"
lb chroot_hooks "${@}"
lb chroot_hacks "${@}"
lb chroot_interactive "${@}"

Installed_packages chroot.packages.live

# Deconfiguring chroot
lb chroot_prep remove all mode-archives-chroot "${@}"

# Saving live OS chroot to cache
lb chroot_cache save "${@}"

Chroot chroot "ls -lR" > chroot.files

Echo_message "Chroot stage completed"
