#!/bin/sh
set -e
# /etc/grub.d/06_lcos_bootmenu (lcos-bootmenu 1.1.0-1)
# Runs after 00_header has set the timeout. Opens the menu when the
# rEFInd "Boot options" entry exported lcos_show_menu=1, or when Shift
# is already held. Does nothing otherwise, so a BIOS install (timeout 5,
# menu visible) and a 1.0.x system that has not opted in stay as they are.
cat << 'EOF'
# lcos-bootmenu: the rEFInd "Boot options" loader exports lcos_show_menu=1
# before this config is read. Holding Shift does the same when GRUB starts.
if [ "${lcos_show_menu}" = "1" ]; then
    set timeout_style=menu
    set timeout=-1
else
    if insmod keystatus; then
        if keystatus --shift; then
            set timeout_style=menu
            set timeout=-1
        fi
    fi
fi
EOF
