 // Add a specified EFI boot loader to the list, using automatic settings
 // for icons, options, etc.
+// LCOS 1.1: the label under an icon is a short OS name (LCOS, Windows,
+// Haiku, Linux, macOS), not "Boot <loader> from <volume>".
+static CHAR16 * LcosShortName(IN CHAR16 *LoaderTitle, IN CHAR16 *LoaderPath) {
+    if ((LoaderPath && StriSubCmp(L"bootmgfw", LoaderPath)) ||
+        (LoaderTitle && (StriSubCmp(L"Microsoft", LoaderTitle) || StriSubCmp(L"Windows", LoaderTitle))))
+        return StrDuplicate(L"Windows");
+    if ((LoaderPath && StriSubCmp(L"haiku", LoaderPath)) ||
+        (LoaderTitle && StriSubCmp(L"Haiku", LoaderTitle)))
+        return StrDuplicate(L"Haiku");
+    if (LoaderPath && (StriSubCmp(L"CoreServices", LoaderPath) || StriSubCmp(L"System\\Library", LoaderPath)))
+        return StrDuplicate(L"macOS");
+    if (LoaderTitle && StriSubCmp(L"macOS", LoaderTitle))
+        return StrDuplicate(L"macOS");
+    if ((LoaderPath && (StriSubCmp(L"grub", LoaderPath) || StriSubCmp(L"vmlinuz", LoaderPath) ||
+                        StriSubCmp(L"bzImage", LoaderPath) || StriSubCmp(L"linux", LoaderPath) ||
+                        StriSubCmp(L"elilo", LoaderPath))) ||
+        (LoaderTitle && (StriSubCmp(L"Linux", LoaderTitle) || StriSubCmp(L"GRUB", LoaderTitle))))
+        return StrDuplicate(L"Linux");
+    if (LoaderTitle && LoaderTitle[0] != L'\0' && !StriSubCmp(L"\\", LoaderTitle) && !StriSubCmp(L"/", LoaderTitle))
+        return StrDuplicate(LoaderTitle);
+    if (LoaderPath)
+        return StrDuplicate(LoaderPath);
+    return StrDuplicate(L"Boot");
+}
