 // graphical main menu style
 //
 
+// LCOS: room under each OS icon for its name. Stock rEFInd draws one
+// label for the current selection only, centered under the tool row.
+static UINTN LcosLabelSpace(VOID) {
+    if (GlobalConfig.HideUIFlags & HIDEUI_FLAG_LABEL)
+        return 0;
+    return egGetFontHeight() + 6;
+}
+
+static VOID LcosDrawIconLabel(REFIT_MENU_ENTRY *Entry, UINTN XPos, UINTN YPos) {
+    UINTN TextWidth, LabelX, Tile;
+
+    // Names sit under the OS row only. Tool captions are wider than the
+    // small icons and run into each other.
+    if (LcosLabelSpace() == 0 || Entry == NULL || Entry->Row != 0 ||
+        Entry->Title == NULL || Entry->Title[0] == L'\0')
+        return;
+    Tile = TileSizes[Entry->Row];
+    egMeasureText(Entry->Title, &TextWidth, NULL);
+    if (TextWidth >= Tile)
+        LabelX = (XPos + Tile > TextWidth) ? (XPos + Tile - TextWidth) / 2 : XPos;
+    else
+        LabelX = XPos + (Tile - TextWidth) / 2;
+    DrawTextWithTransparency(Entry->Title, LabelX, YPos + Tile + 2);
+}
