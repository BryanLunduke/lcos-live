#!/bin/sh
set -e
# LCOS 0.9.5-1 (r15 U-1): file trigger on /boot, modules and firmware ->
# write /var/run/reboot-required(.pkgs) for kernel/firmware/microcode.
if [ "$1" = triggered ]; then
  /usr/lib/lcos/lcos-reboot-required || true
  exit 0
fi
if [ "$1" = configure ]; then
  # first install: start reading dpkg.log from here, don't flag history
  [ -f "${DPKG_ROOT:-}"/var/lib/lcos/reboot-required.offset ] || { /usr/lib/lcos/lcos-reboot-required --init && /usr/lib/lcos/lcos-reboot-required; } || true
  /usr/local/sbin/lcos-write-os-release || true

  # LCOS 0.9.5-4: installers before 0.9.5 left users out of lpadmin, so
  # adding a printer failed with CUPS 'forbidden'. Once, on upgrade from
  # below 0.9.5-4, add existing sudo-group users (UID 1000-59999) to
  # lpadmin. Fresh installs ($2 empty) are left to the installer. Takes
  # effect at the user's next login.
  if [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt 0.9.5-4 && \
     getent group lpadmin >/dev/null 2>&1 && getent group sudo >/dev/null 2>&1; then
    for u in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
      uid=$(id -u "$u" 2>/dev/null) || continue
      [ "$uid" -ge 1000 ] && [ "$uid" -le 59999 ] || continue
      id -nG "$u" | tr ' ' '\n' | grep -qx lpadmin && continue
      usermod -aG lpadmin "$u" && echo "lcos-base: added $u to lpadmin (printer admin)" || true
    done
  fi

  # LCOS 0.9.5-6 (M-1): images before 0.9.5-6 shipped the ISO-build-only
  # /etc/apt/apt.conf.d/00lcos-noninteractive (APT::Get::Assume-Yes), so
  # terminal apt never asked before removing. Once, on upgrade from below
  # 0.9.5-6, remove it if it is byte-identical to the shipped file (same
  # since 0.8); a locally edited copy or a symlink is kept. Fresh installs
  # ($2 empty) are skipped: the ISO build itself still needs the file.
  if [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt 0.9.5-6; then
    nonint="${DPKG_ROOT:-}/etc/apt/apt.conf.d/00lcos-noninteractive"
    if [ -f "$nonint" ] && [ ! -L "$nonint" ] && \
       [ "$(sha256sum < "$nonint" | cut -d' ' -f1)" = 21458429a9cac275f0dc32beac8fca2ef4c96088b78aec5bd7dbb0a861b1709e ]; then
      rm -f "$nonint" && echo "lcos-base: removed /etc/apt/apt.conf.d/00lcos-noninteractive (apt asks before changes again)" || true
    fi
  fi

  # LCOS 0.9.5-4: print-queue tray icon off by default. Done here, not by
  # shipping the file: Depends makes system-config-printer configured before
  # this runs, so its conffile is in place and --rename moves it to
  # .distrib (outside the *.desktop glob); its later upgrades land there.
  # Our Hidden=true copy is not dpkg-owned, so the two packages never
  # contend for the path. A copy without the marker (local edit) is kept.
  applet=/etc/xdg/autostart/print-applet.desktop
  dpkg-divert --package lcos-base --add --rename \
    --divert "$applet.distrib" "$applet" >/dev/null
  if [ ! -e "${DPKG_ROOT:-}$applet" ] || grep -q '^# lcos-base generated' "${DPKG_ROOT:-}$applet"; then
    install -m 0644 /usr/share/lcos-base/print-applet-hidden.desktop "${DPKG_ROOT:-}$applet"
  fi

  # LCOS 0.9.5-2 (#112): boot services no longer get HOME=/ (see
  # /lib/lsb/init-functions.d/05-lcos-home). Remove the Mesa shader cache
  # an X server with HOME=/ could leave in /.cache, and /.cache itself if
  # it is then empty (it is recreated until the next reboot otherwise).
  rm -rf "${DPKG_ROOT:-}/.cache/mesa_shader_cache" "${DPKG_ROOT:-}/.cache/mesa_shader_cache_db"
  rmdir "${DPKG_ROOT:-}/.cache" 2>/dev/null || true

  # LCOS 0.9: apply /etc/insserv/overrides/{plymouth,lightdm}.
  # plymouth: drop the runlevel 2-5 start link (its start action only ran
  #   "plymouth quit --retain-splash" while LightDM was starting X); keep
  #   the 0/6 stop links for the shutdown splash.
  # lightdm: re-sequence so it starts after elogind and seatd.
  if command -v update-rc.d >/dev/null 2>&1; then
    if [ -x /etc/init.d/plymouth ] && [ -f /etc/insserv/overrides/plymouth ]; then
      update-rc.d -f plymouth remove >/dev/null 2>&1 || true
      update-rc.d plymouth defaults >/dev/null 2>&1 || true
    fi
    if [ -x /etc/init.d/lightdm ] && [ -f /etc/insserv/overrides/lightdm ]; then
      update-rc.d lightdm defaults >/dev/null 2>&1 || true
    fi
  fi
  # LCOS 0.9.2-2 (#115/#118): no AMD Xorg driver override any more. Remove
  # the snippets 0.9.1's boot helper created (not dpkg-owned; the 0.9-1
  # dpkg-owned copies are removed by dpkg itself) and its state file, so Xorg
  # autoselects as in 0.8. /etc/lcos/amdgpu-ddx (admin override) is left alone
  # but is no longer read.
  rm -f "${DPKG_ROOT:-}"/usr/share/X11/xorg.conf.d/05-lcos-amdgpu-modesetting.conf \
        "${DPKG_ROOT:-}"/usr/share/X11/xorg.conf.d/15-lcos-amdgpu-hotplug.conf \
        "${DPKG_ROOT:-}"/run/lcos-amdgpu-ddx
  rmdir "${DPKG_ROOT:-}"/usr/share/lcos/xorg 2>/dev/null || true


  # LCOS 0.9.4-5: enable sysvinit wrappers for Debian systemd-only daemons
  # (thermald, iio-sensor-proxy, switcheroo-control, ipp-usb). Scripts are
  # no-ops when the package binary is missing.
  if command -v update-rc.d >/dev/null 2>&1; then
    for svc in thermald iio-sensor-proxy switcheroo-control ipp-usb; do
      if [ -x "/etc/init.d/$svc" ]; then
        update-rc.d "$svc" defaults >/dev/null 2>&1 || true
      fi
    done
  fi
  # LCOS 0.9.4-3: user namespaces on now (Steam etc.). Apply our file
  # immediately unless the admin overrides it with the same name in /etc.
  # The /etc/sysctl.d/99-lcos-hardening.conf left by older ISOs is not
  # touched; this file sorts after it at boot. Fails harmlessly in a chroot
  # or container where /proc/sys is read-only or absent, and is skipped in
  # a chroot (ISO build) so the build host's kernel is not changed.
  in_chroot=no
  if command -v ischroot >/dev/null 2>&1 && ischroot; then in_chroot=yes; fi
  if [ -z "${DPKG_ROOT:-}" ] && [ "$in_chroot" = no ] && [ ! -e /etc/sysctl.d/99-lcos-userns.conf ] && \
     [ -w /proc/sys/user/max_user_namespaces ] && command -v sysctl >/dev/null 2>&1; then
    sysctl -q -p /usr/lib/sysctl.d/99-lcos-userns.conf >/dev/null 2>&1 || true
  fi
fi
dpkg-maintscript-helper rm_conffile /etc/init.d/lcos-amdgpu-ddx 0.9.2-2~ lcos-base -- "$@"
exit 0
