#!/bin/sh
set -e
# After purge the insserv overrides are gone: restore stock plymouth/lightdm
# links and ordering from their own LSB headers.
if [ "$1" = purge ] && command -v update-rc.d >/dev/null 2>&1; then
  if [ -x /etc/init.d/plymouth ] && [ ! -f /etc/insserv/overrides/plymouth ]; then
    update-rc.d -f plymouth remove >/dev/null 2>&1 || true
    update-rc.d plymouth defaults >/dev/null 2>&1 || true
  fi
  if [ -x /etc/init.d/lightdm ] && [ ! -f /etc/insserv/overrides/lightdm ]; then
    update-rc.d lightdm defaults >/dev/null 2>&1 || true
  fi
fi
# LCOS 0.9.1-2: the AMD modesetting snippets in /usr/share/X11/xorg.conf.d are
# created at boot by lcos-amdgpu-ddx and are not owned by dpkg; remove them
# with the package so no stale always-on copy is left behind.
if [ "$1" = remove ] || [ "$1" = purge ]; then
  rm -f /usr/share/X11/xorg.conf.d/05-lcos-amdgpu-modesetting.conf \
        /usr/share/X11/xorg.conf.d/15-lcos-amdgpu-hotplug.conf \
        /run/lcos-amdgpu-ddx
fi
if [ "$1" = purge ] && command -v update-rc.d >/dev/null 2>&1; then
  update-rc.d lcos-amdgpu-ddx remove >/dev/null 2>&1 || true
fi
exit 0
