#!/bin/sh
### BEGIN INIT INFO
# Provides:          ipp-usb
# Required-Start:    $remote_fs $syslog avahi
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: IPP-over-USB printer support
# Description:       Exposes USB printers as IPP (LCOS sysvinit wrapper;
#                    Debian package uses SYSTEMD_WANTS from udev).
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/ipp-usb
NAME=ipp-usb
DESC="IPP-over-USB"
PIDFILE=/run/ipp-usb.pid

[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

case "$1" in
  start)
	log_daemon_msg "Starting $DESC" "$NAME"
	start-stop-daemon --start --quiet --pidfile "$PIDFILE" --make-pidfile \
		--background --exec "$DAEMON" || { log_end_msg 1; exit 1; }
	log_end_msg 0
	;;
  stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry=TERM/10/KILL/5
	rm -f "$PIDFILE"
	log_end_msg $?
	;;
  restart|force-reload)
	$0 stop
	$0 start
	;;
  status)
	status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
	;;
  *)
	echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
	exit 3
	;;
esac
exit 0
