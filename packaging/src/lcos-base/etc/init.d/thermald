#!/bin/sh
### BEGIN INIT INFO
# Provides:          thermald
# Required-Start:    $remote_fs $syslog dbus
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Thermal Daemon
# Description:       Intel/platform thermal management (LCOS sysvinit wrapper;
#                    Debian package ships only a systemd unit).
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/thermald
NAME=thermald
DESC="Thermal Daemon"

[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

case "$1" in
  start)
	log_daemon_msg "Starting $DESC" "$NAME"
	# Daemonizes itself. No --systemd (that is for sd_notify).
	start-stop-daemon --start --quiet --exec "$DAEMON" \
		-- --dbus-enable --adaptive \
		|| { log_end_msg 1; exit 1; }
	log_end_msg 0
	;;
  stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	start-stop-daemon --stop --quiet --exec "$DAEMON" --retry=TERM/10/KILL/5
	log_end_msg $?
	;;
  restart|force-reload)
	$0 stop
	$0 start
	;;
  status)
	status_of_proc "$DAEMON" "$NAME"
	;;
  *)
	echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
	exit 3
	;;
esac
exit 0
