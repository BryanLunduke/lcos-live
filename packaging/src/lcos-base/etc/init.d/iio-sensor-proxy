#!/bin/sh
### BEGIN INIT INFO
# Provides:          iio-sensor-proxy
# Required-Start:    $remote_fs $syslog dbus
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: IIO Sensor Proxy
# Description:       Accelerometer / ALS / orientation D-Bus proxy (LCOS
#                    sysvinit wrapper; Debian package uses SYSTEMD_WANTS).
### END INIT INFO

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/libexec/iio-sensor-proxy
NAME=iio-sensor-proxy
DESC="IIO Sensor Proxy"
PIDFILE=/run/iio-sensor-proxy.pid

[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

case "$1" in
  start)
	log_daemon_msg "Starting $DESC" "$NAME"
	start-stop-daemon --start --quiet --pidfile "$PIDFILE" --make-pidfile \
		--background --exec "$DAEMON" || { log_end_msg 1; exit 1; }
	log_end_msg 0
	;;
  stop)
	log_daemon_msg "Stopping $DESC" "$NAME"
	start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry=TERM/10/KILL/5
	rm -f "$PIDFILE"
	log_end_msg $?
	;;
  restart|force-reload)
	$0 stop
	$0 start
	;;
  status)
	status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
	;;
  *)
	echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
	exit 3
	;;
esac
exit 0
