#!/bin/sh
### BEGIN INIT INFO
# Provides:          lcos-amdgpu-ddx
# Required-Start:    mountkernfs $local_fs udev
# Required-Stop:
# Should-Start:      kmod
# Default-Start:     S
# Default-Stop:
# Short-Description: LCOS: pick the Xorg driver for AMD GPUs
# Description:       Installs the LCOS modesetting+glamor Xorg snippets only
#                    when every amdgpu-bound GPU is Vega/GFX9 or newer, and
#                    removes them otherwise (LCOS #115/#118). See
#                    /usr/lib/lcos/lcos-amdgpu-ddx. Override with kernel
#                    cmdline lcos.amdgpu=modesetting|amdgpu|auto or
#                    /etc/lcos/amdgpu-ddx.
### END INIT INFO

. /lib/lsb/init-functions

HELPER=/usr/lib/lcos/lcos-amdgpu-ddx
# lcos-base removed but not purged: nothing to do.
[ -x "$HELPER" ] || exit 0

case "$1" in
start|restart|force-reload)
	"$HELPER" || true
	;;
stop|status)
	[ "$1" = status ] && cat /run/lcos-amdgpu-ddx 2>/dev/null
	;;
*)
	echo "Usage: /etc/init.d/lcos-amdgpu-ddx {start|stop|restart|force-reload|status}" >&2
	exit 3
	;;
esac
exit 0
