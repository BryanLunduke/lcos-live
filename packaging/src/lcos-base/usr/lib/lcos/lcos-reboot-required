#!/bin/sh
# /usr/lib/lcos/lcos-reboot-required  (lcos-base 0.9.5-1, review r15 U-1)
# Run from lcos-base's dpkg file trigger whenever a package touches /boot,
# the kernel module tree or the firmware tree. Every LCOS kernel is named
# 7.2.6-lunduke, so a version change can't be relied on; instead read the
# dpkg log written since the last run and flag every linux-image-*,
# firmware-*, intel-microcode or amd64-microcode install/upgrade
# (same-version reinstalls included). Writes the Debian markers
# /var/run/reboot-required and /var/run/reboot-required.pkgs that the
# Updates app watches. No systemd.
#   --init  first install: start from the current dpkg run (last
#           "startup archives" line), so a kernel unpacked in the same
#           apt run as lcos-base is still flagged but older history isn't.
set -e
LOG="${DPKG_ROOT:-}/var/log/dpkg.log"
STATE_DIR="${DPKG_ROOT:-}/var/lib/lcos"
OFF="$STATE_DIR/reboot-required.offset"
RUN="${DPKG_ROOT:-}/var/run"
mkdir -p "$STATE_DIR"
size=0
[ -f "$LOG" ] && size=$(wc -c < "$LOG")
if [ "${1:-}" = --init ]; then
	pos=0
	[ -f "$LOG" ] && pos=$(LC_ALL=C awk '/ startup archives /{p=n} {n+=length($0)+1} END{print p+0}' "$LOG")
	echo "$pos" > "$OFF"; exit 0
fi
# Skip inside a chroot (ISO build): the live image must not ship a marker.
if [ -z "${LCOS_REBOOT_FORCE:-}" ] && command -v ischroot >/dev/null 2>&1 && ischroot; then
	echo "$size" > "$OFF"; exit 0
fi
start=0
[ -f "$OFF" ] && start=$(cat "$OFF" 2>/dev/null || echo 0)
case "$start" in ''|*[!0-9]*) start=0 ;; esac
[ "$start" -gt "$size" ] && start=0   # log was rotated
pkgs=""
if [ -f "$LOG" ] && [ "$size" -gt "$start" ]; then
	pkgs=$(tail -c +"$((start + 1))" "$LOG" | awk '
		$3 == "install" || $3 == "upgrade" {
			p = $4; sub(/:.*/, "", p)
			if (p ~ /^linux-image-/ || p ~ /^firmware-/ || p == "intel-microcode" || p == "amd64-microcode") print p
		}' | sort -u)
fi
echo "$size" > "$OFF"
[ -n "$pkgs" ] || exit 0
mkdir -p "$RUN"
echo "*** System restart required ***" > "$RUN/reboot-required"
for p in $pkgs; do
	grep -qx "$p" "$RUN/reboot-required.pkgs" 2>/dev/null || echo "$p" >> "$RUN/reboot-required.pkgs"
done
exit 0
