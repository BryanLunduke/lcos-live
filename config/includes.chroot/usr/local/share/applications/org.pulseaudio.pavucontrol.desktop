# LCOS 1.1.0-3: Command Center covers this. The owning package stays
# installed (Command Center launches the program directly). NoDisplay
# hides the entry from Settings and every other menu category. This
# file is in /usr/local/share/applications so it wins over the package
# .desktop and survives package upgrades. Launching this id still runs
# the tool.
# Trixie pavucontrol 6.1-1 ships this desktop id, not pavucontrol.desktop.
[Desktop Entry]
Version=1.0
Type=Application
Name=Volume Control
Comment=Adjust the volume level
Exec=pavucontrol
Icon=multimedia-volume-control
Terminal=false
StartupNotify=true
NoDisplay=true
OnlyShowIn=XFCE;
