#!/bin/sh
# LCOS 0.9.3: LIVE SESSION ONLY - turn off X core screensaver/DPMS blanking.
# Screensaver/lock/DPMS xfconf defaults (all off) ship system-wide in
# lcos-desktop-config 0.9.3-2 (/etc/xdg); this only adds `xset s off -dpms`
# for the live user. live-config runs this only on boot=live (after
# 0030-user-setup created the home) and Calamares removes live-config from
# installed systems. The autostart file lives in the live user's $HOME, which
# unpackfs does not copy (it unpacks the squashfs, not the running overlay).

. /lib/live/config.sh

Init ()
{
	if component_was_executed "lcos-live-no-screensaver"; then
		exit 0
	fi
	echo -n " lcos-live-no-screensaver"
}

Config ()
{
	_USER=lcos
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE:-$(cat /proc/cmdline)}; do
		case "${_PARAMETER}" in
		live-config.username=*|username=*) _USER="${_PARAMETER#*username=}" ;;
		esac
	done
	_HOME="/home/${_USER}"
	if ! getent passwd "${_USER}" >/dev/null 2>&1 || [ ! -d "${_HOME}" ]; then
		touch /var/lib/live/config/lcos-live-no-screensaver
		return 0
	fi
	mkdir -p "${_HOME}/.config/autostart"

	cat > "${_HOME}/.config/autostart/lcos-live-no-blank.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=LCOS live: no screen blanking
Comment=Live session only (2030-lcos-live-no-screensaver)
Exec=sh -c 'sleep 5; xset s off -dpms; xset s noblank'
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

	chown -R "${_USER}:${_USER}" "${_HOME}/.config/autostart" || true
	touch /var/lib/live/config/lcos-live-no-screensaver
}

Init
Config
