# lcos18: DM_CRYPT=m + XTS (#123), UHID=m (#120), RMI4_F11=y (#121).
# lcos19: radeon=m, vga_switcheroo, DC_SI, HSA, FW compress (#115/#118); 948 modules. No Forced Rust.
