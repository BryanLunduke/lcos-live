# Hardware peripherals for LCOS 0.8 (editor via Ted 2026-09-25).
# Recipe installs no Recommends — list hard-needed companions explicitly.
# Do NOT add hplip or proprietary NVIDIA.

# Bluetooth
bluez
blueman
# blueman Depends (would resolve anyway; listed for clarity)
bluez-obexd
# BT audio with existing PulseAudio (blueman Recommends)
pulseaudio-module-bluetooth

# Printing — CUPS + Gutenprint (no hplip)
cups
cups-client
cups-filters
printer-driver-gutenprint
# Network printer discovery (cups Recommends; needed for a usable stack)
avahi-daemon
# Resolve <printer>.local names (postinst adds mdns4_minimal to nsswitch.conf)
libnss-mdns
# Print Settings GUI. cups-pk-helper is only a Recommends of
# system-config-printer-common and we build with --apt-recommends false,
# so list it explicitly (polkit backend for printer admin actions).
system-config-printer
cups-pk-helper

# Scanning
sane-utils
simple-scan

# Video4Linux
v4l-utils

# Vulkan (Mesa ICDs only)
mesa-vulkan-drivers

# Thunderbolt / USB4 userspace (editor via Ted 2026-10-02)
bolt

# ALSA Use Case Manager configs (better laptop/codec profiles; alsa-utils already in desktop)
alsa-ucm-conf

# VM guest agents (SPICE/QEMU display+clipboard; VMware tools)
spice-vdagent
open-vm-tools

# Broadcom b43 / b43legacy Wi-Fi firmware (MacBook-era SSB/BCMA).
# Devuan Excalibur contrib (already in LB_ARCHIVE_AREAS). Not precut blobs:
# postinst wget's the proprietary extract during chroot package install
# (b43: github.com/minios-linux/b43-firmware; legacy: downloads.openwrt.org).
# b43-fwcutter is a Depends (1:019-14). Do NOT add broadcom-sta / wl.
firmware-b43-installer
firmware-b43legacy-installer

# Firmware metapackages (0.9.3). 0.9.1 shipped them; 0.9.2 (092-02) lost them
# once firmware came from excalibur-backports. lcos-amd-backports.pref pins
# both to the backports version (firmware-linux-nonfree Depends on
# firmware-amd-graphics/firmware-misc-nonfree at the exact same version).
firmware-linux
firmware-linux-nonfree

# Ubuntu 26.10 hardware gap (0.9.4, editor 2026-10-15): firmware refresh +
# device services. iwlwifi / intel-* pinned to backports 20260810 via
# lcos-amd-backports.pref.
# 0.9.7 (A1): firmware-sof-signed 2026.09.1-1 (Debian forky, unmodified)
# is a local deb in config/packages.chroot/ for Panther Lake / Wildcat Lake
# audio; config/archives/lcos-sof-firmware.pref.chroot makes it win over
# excalibur 2025.01-1. See SEED-sof-firmware-2026.09.1.txt.
firmware-iwlwifi
firmware-intel-sound
firmware-intel-graphics

# Device firmware updates (D-Bus activated; opensysusers provides systemd-sysusers)
fwupd

# Intel laptop thermal daemon (sysvinit script shipped by lcos-base)
thermald

# Convertible / ambient-light sensors (sysvinit script shipped by lcos-base)
iio-sensor-proxy

# Hybrid GPU switching userspace (sysvinit script shipped by lcos-base)
switcheroo-control

# Driverless USB IPP printers (udev + sysvinit script shipped by lcos-base)
ipp-usb

# Modern network scanners (eSCL/WSD); SANE plugin, no daemon
sane-airscan

# Intel VA-API iHD (AMD already has mesa-va-drivers / radeonsi)
intel-media-va-driver

# USB device listing (#176, editor 2026-10-27): lsusb. pciutils (lspci) and
# dmidecode were already in the image; libusb-1.0-0 and libeudev1 (libudev1)
# are too, so this adds only usbutils 1:018-2 (~0.3 MB installed).
usbutils

# NTFS tools (ntfsresize for Calamares/GParted shrinking Windows, ntfsfix);
# only a Recommends of udisks2, so --apt-recommends false left it out
ntfs-3g
