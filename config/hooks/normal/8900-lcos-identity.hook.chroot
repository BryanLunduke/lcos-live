#!/bin/sh
set -e
# Late write: debootstrap/live-build often replace os-release.
# Identity is LCOS 0.8. Live hostname LCOS, live user lcos.
printf "%s\n" "LCOS" > /etc/hostname
printf "%s\n" "LCOS 0.8 \\n \\l" > /etc/issue
printf "%s\n" "LCOS 0.8" > /etc/issue.net
cat > /etc/os-release <<'OS'
PRETTY_NAME="LCOS 0.8"
NAME="LCOS"
VERSION_ID="0.8"
VERSION="0.8 (excalibur)"
VERSION_CODENAME=excalibur
ID=lcos
ID_LIKE="devuan debian"
HOME_URL="https://lunduke.com"
SUPPORT_URL="https://lunduke.com"
BUG_REPORT_URL="https://lunduke.com"
OS
mkdir -p /usr/lib
cp -f /etc/os-release /usr/lib/os-release
