#!/bin/sh
set -e
# LCOS 0.9.2 (#115/#118): no AMD Xorg driver override. Xorg autoselects as in
# 0.8. Fail the build if any piece of the 0.9/0.9.1 override is in the image.
bad=0
for f in /usr/share/X11/xorg.conf.d/05-lcos-amdgpu-modesetting.conf \
	/usr/share/X11/xorg.conf.d/15-lcos-amdgpu-hotplug.conf \
	/etc/X11/xorg.conf.d/05-lcos-amdgpu-modesetting.conf \
	/etc/X11/xorg.conf.d/15-lcos-amdgpu-hotplug.conf \
	/usr/share/lcos/xorg/05-lcos-amdgpu-modesetting.conf \
	/usr/lib/lcos/lcos-amdgpu-ddx /etc/init.d/lcos-amdgpu-ddx; do
	if [ -e "$f" ]; then echo "lcos-amdgpu-ddx-guard: unexpected $f" >&2; bad=1; fi
done
if ls /etc/rcS.d/*lcos-amdgpu-ddx >/dev/null 2>&1; then
	echo "lcos-amdgpu-ddx-guard: stale rcS link" >&2; bad=1
fi
exit $bad
