#!/bin/sh
set -e
# LCOS 0.9.5 / LLK default: custom linux-image with --linux-packages none may not
# generate initrd during dpkg configure; force it for the Lunduke ABI.
# LCOS 1.0.1: LLK 7.2.15-lcos33 (kernel release 7.2.15-lunduke since lcos30; was 7.2.6-lunduke).
KVER="7.2.15-lunduke"
if [ -e "/boot/vmlinuz-${KVER}" ] && [ ! -e "/boot/initrd.img-${KVER}" ]; then
	echo "I: LCOS 0.9.5 LLK hook: generating initrd for ${KVER}"
	update-initramfs -c -k "${KVER}"
elif [ -e "/boot/vmlinuz-${KVER}" ]; then
	echo "I: LCOS 0.9.5 LLK hook: refreshing initrd for ${KVER}"
	update-initramfs -u -k "${KVER}" || update-initramfs -c -k "${KVER}"
fi
if [ ! -e "/boot/vmlinuz-${KVER}" ]; then
	echo "E: LCOS LLK hook: /boot/vmlinuz-${KVER} missing (seeded kernel and KVER out of step)" >&2
	exit 1
fi
ls -la /boot/vmlinuz-* /boot/initrd.img-* 2>/dev/null || true
